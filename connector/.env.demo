TALLY_PORT=9000
TALLY_PROTOCOL=http
TALLY_COMPANY=Bright Connection
TALLY_TIMEOUT_MS=15000
TALLY_TENANT_ID=tenant_bright_connection_001

# Cloud ARTHA (destination)
CLOUD_URL=https://artha.blackholeinfiverse.com
CLOUD_API_KEY=404bc199ce6e26faf308aaa51bb48981315cd8b33e62900491f3e9ec72275ace
CLOUD_HMAC_SECRET=f139954315d71e02226d1d26d629a68902a38ddc0666161ceac1c55423dccf3b
CLOUD_TIMEOUT_MS=30000

# Sync Schedule
SYNC_INTERVAL_MINUTES=15
