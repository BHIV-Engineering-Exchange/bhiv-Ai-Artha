# Server
NODE_ENV=development
PORT=5000
API_VERSION=v1
LOG_LEVEL=debug

# Database
MONGODB_URI=mongodb+srv://user:pass@cluster.example.mongodb.net/?appName=Artha
MONGODB_TEST_URI=mongodb+srv://user:pass@cluster.example.mongodb.net/?appName=Artha

# JWT for local login (POST /api/v1/auth/login) and Bearer auth on API routes.
JWT_SECRET=blackhole-auth-super-secure-random-secret-min-32-chars
# Optional access token lifetime (default 7d)
# JWT_EXPIRES_IN=7d

# --- URLs (pick ONE style) ---
# Legacy (still supported): API base + SPA
#   APP_URL = this API’s public base (http://localhost:5000 or https://api.example.com)
#   FRONTEND_URL = SPA (http://localhost:5173 or https://app.example.com)
# New: SPA-only APP_URL + explicit API
#   APP_URL = SPA origin only
#   API_PUBLIC_URL = this API’s public base (required in production when SPA is not on API host)

APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
# API_PUBLIC_URL=https://your-api.onrender.com

# Optional: full URL where unauthenticated users should go (default: {SPA}/login)
# APP_LOGIN_URL=https://ai-artha.vercel.app/login

# Comma-separated CORS browser origins (must match Origin header; credentialed requests).
# CORS_ALLOWED_ORIGINS=https://app.example.com,http://localhost:5173
CORS_ORIGIN=http://localhost:5173
# ALLOW_LOCALHOST_CORS=false

# If set, JWT payload must include this app in allowedApps (see signAccessToken).
# APP_ID=artha
# BHIV_APP_ID=artha

# Security
HMAC_SECRET=your-hmac-secret-for-ledger-chain
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# AUTH_PASSWORD_RATE_LIMIT_MAX=10
# AUTH_SIGNUP_RATE_LIMIT_MAX=20
# TRUST_PROXY=0  # set to disable trust proxy (default: on for Render)

# InsightCore
INSIGHTCORE_ENDPOINT=http://localhost:8000/telemetry
INSIGHTCORE_ENABLED=false

# SETU Integration (signal dispatch)
# Set SETU_ENABLED=true to dispatch signals to SETU. Default: false (signals persisted locally only)
SETU_ENABLED=false
SETU_BASE_URL=https://setu.example.com
SETU_API_KEY=
SETU_TIMEOUT_MS=5000

# Mitra AI Integration
MITRA_API_URL=https://mitra.blackholeinfiverse.com
MITRA_API_KEY=
MITRA_TIMEOUT_MS=30000

# Activation Codes (modular — replace with enterprise IdP in production)
ACTIVATION_CODE_ADMIN=#BHIVATH01
ACTIVATION_CODE_ACCOUNTANT=#BHIVATH01

# Storage for expenses
STORAGE_TYPE=local
AWS_BUCKET_NAME=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Tally read-only connector (Bright Connection) — XML gateway
# Discovered gateway (from TallyPrime About screen): SERVER on 192.168.0.72,
# Client/Server with ODBC | Port: 9000, no proxy for the gateway server.
# NOTE: port 9000 was NOT reachable from the dev machine — Tally's Windows
# Firewall must allow inbound TCP 9000 and both machines must share the LAN
# (192.168.x). Set TALLY_ENABLED=true once reachable.
TALLY_ENABLED=false
TALLY_PROTOCOL=http
TALLY_HOST=192.168.0.72
TALLY_PORT=9000
TALLY_COMPANY=
# Optional basic auth for a gateway/proxy (classic Tally :9000 usually needs
# none). NEVER hardcode — env only.
TALLY_BASIC_USERNAME=
TALLY_BASIC_PASSWORD=
TALLY_TIMEOUT_MS=15000
TALLY_TENANT_ID=tenant_bright_connection_001

# Automatic Tally → ARTHA sync: new data added in Tally (parties, invoices,
# receipts, payments) flows into ARTHA automatically on this interval.
TALLY_SYNC_ENABLED=true
TALLY_SYNC_INTERVAL_MINUTES=15
TALLY_SYNC_DEFAULT_FROM_DAYS=30

# SETU delivery for Tally connector records (real SETU ingest endpoint from Raj)
# Leave blank to skip direct dispatch (ARTHA signal pipeline still available).
TALLY_SETU_ENDPOINT=
TALLY_SETU_HMAC_SECRET=
TALLY_SETU_TIMEOUT_MS=10000
TALLY_SETU_MAX_RETRIES=3

# Tally Connector Ingestion (cloud side: receives data from connector agent)
# Set TALLY_CONNECTOR_API_KEY and TALLY_CONNECTOR_HMAC_SECRET to the same
# values configured in the connector's .env on the Tally LAN machine.
TALLY_CONNECTOR_API_KEY=
TALLY_CONNECTOR_HMAC_SECRET=

# Demo seed location (used by npm run seed:demo)
# Set your city coordinates and details here to seed data for your location.
DEMO_DEFAULT_LAT=19.0760
DEMO_DEFAULT_LNG=72.8777
DEMO_DEFAULT_CITY=Mumbai
DEMO_DEFAULT_STATE=Maharashtra
DEMO_DEFAULT_PINCODE_PREFIX=4000
